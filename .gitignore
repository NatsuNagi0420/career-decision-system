# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Python — the v2 server is the only Python service; the rule is global on purpose so
# a new package can never leak its bytecode.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Node
node_modules/
dist/
.vite/
playwright-report/
test-results/
*.tsbuildinfo

# Local secrets and local state. `.env.example` files are tracked; `.env` never is.
.env
.env.local
.env.relay
*.pem

# Generated at runtime, never authored
logs/
uploads/
backups/
pilot-results/
.local-https/
server/var/
*.log
*.sqlite
*.sqlite-journal
.last_run_id

# Scratch produced by shell mistakes on Windows (a literal "%SystemDrive%" directory)
%SystemDrive%/

# Vendored third-party reference repos (read-only study material, ~31k files).
# They are not part of this product and carry their own licenses.
参考开源项目/

# Scratch: unzipped .docx review material
.docx-review-*/

# Playwright output: screenshots and the last run report
web/e2e/.shots/

# Whole-font downloads that `npm run fonts` cuts down to the shipped subset. Never
# served, always regenerable — 450 KB of Material Symbols has no business in history.
web/.font-src/

# TypeScript Agent local state and official relay database (never commit secrets).
agent/var/
agent/relay-var/
*.sqlite-wal
*.sqlite-shm

# Local scratch and generated source material never enter Git.
tmp/

# Raw research and art handoff files stay in the local workspace or an artifact store.
docs/参考资料/**/*.pdf
docs/参考资料/工具/网页原件/
docs/品牌形象/**/*.zip
docs/品牌形象/**/*.psd
docs/品牌形象/**/*.kra
docs/品牌形象/**/*.clip
docs/岗位库扩充/**/待导入/*.zip

# Large local handoff bundle; curated assets are tracked in uni-app/assets and src/static.
assets/穗奈_小程序端原型与透明图标_全量包.zip

# Cloud Hub local credentials/configuration; example files remain tracked.
.env.hub
.env.cloud

# Local reference checkouts, production recordings and original asset bundles.
vendor/
video/
assets/*.zip
