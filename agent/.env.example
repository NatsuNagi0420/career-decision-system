# 青穗集 · TypeScript 本机 Agent 配置模板；不包含官方上游密钥，不分发真实 .env。
AGENT_HOST=127.0.0.1
# local 才提供本机默认应用/文件夹操作；服务器反向代理部署须设为 server。
AGENT_DEPLOYMENT_MODE=local
AGENT_PORT=8110
AGENT_DATA_DIR=./var
AGENT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
AGENT_MAX_STEPS=12
AGENT_RUN_TIMEOUT_MS=180000
# 模型连续无新数据的空闲上限；正常流式输出会续期，整轮仍受 AGENT_RUN_TIMEOUT_MS 限制。
AGENT_MODEL_TIMEOUT_MS=120000
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_MAX_RUN_OUTPUT_TOKENS=16000
# 通用 Agent 上下文预算；旧历史会自动压缩，当前轮工具链优先保留。
AGENT_CONTEXT_MAX_TOKENS=32000
AGENT_CONTEXT_RESERVE_TOKENS=8000
AGENT_CONTEXT_RECENT_TOKENS=10000
AGENT_CONTEXT_MAX_TOOL_CHARS=12000
# auto：Windows 默认使用系统原生写入限制，其他平台使用 Docker。失败不会回退普通终端。
AGENT_SANDBOX_PROVIDER=auto
AGENT_DOCKER_COMMAND=docker
# 开发镜像。正式部署建议使用受信 sha256 摘要；不会自动拉取镜像。
AGENT_DOCKER_IMAGE=python:3.12-slim
# 官方入口和本安装实例的受限访问凭证；绝不是上游模型 Key。
OFFICIAL_GATEWAY_URL=
OFFICIAL_ACCESS_TOKEN=
# 请求时使用的真实模型 ID，必须与 RELAY_UPSTREAM_MODEL 相同，不是界面名称。
OFFICIAL_MODEL=
# 对外名称，不会发送为供应商的模型编号。
OFFICIAL_MODEL_DISPLAY_NAME=Suinai Flash
OFFICIAL_API_KIND=chat-completions
# 以下仅用于单独启动的官方中转服务，不得放进分发给用户的安装包。
RELAY_HOST=127.0.0.1
RELAY_PORT=8120
RELAY_DATA_DIR=./relay-var
RELAY_UPSTREAM_BASE_URL=
RELAY_UPSTREAM_API_KEY=
RELAY_UPSTREAM_MODEL=
RELAY_API_KIND=chat-completions
# 上游无新数据的空闲上限；需与本机模型等待设置相协调。
RELAY_UPSTREAM_IDLE_TIMEOUT_MS=120000
RELAY_MAX_OUTPUT_TOKENS=2048
RELAY_DAILY_OUTPUT_TOKEN_LIMIT=64000
RELAY_DAILY_REQUEST_LIMIT=100
# 仅官方中转在本机测试私网上游时使用；正式上游应走 HTTPS。
RELAY_ALLOW_LOCAL_UPSTREAM=false
