# 青穗集 · 本机 Agent 配置模板；不包含官方上游密钥或内部模型路由。
AGENT_HOST=127.0.0.1
AGENT_DEPLOYMENT_MODE=local
AGENT_PORT=8110
AGENT_DATA_DIR=
AGENT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
AGENT_MAX_STEPS=12
AGENT_MAX_TOTAL_STEPS=120
AGENT_MAX_TASK_STEPS=480
AGENT_MAX_CONTINUATIONS=3
AGENT_RUN_TIMEOUT_MS=180000
AGENT_MODEL_TIMEOUT_MS=120000
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_MAX_RUN_OUTPUT_TOKENS=16000
AGENT_CONTEXT_MAX_TOKENS=32000
AGENT_CONTEXT_RESERVE_TOKENS=8000
AGENT_CONTEXT_RECENT_TOKENS=10000
AGENT_CONTEXT_MAX_TOOL_CHARS=12000
# auto：Windows 使用系统原生写入限制，其他平台使用 Docker；失败不会回退普通终端。
AGENT_SANDBOX_PROVIDER=auto
AGENT_DOCKER_COMMAND=docker
AGENT_DOCKER_IMAGE=python:3.12-slim
# 官方服务只在 8120 端配置真实模型与上游 Key；本机这里只保存官方入口与受限访问凭证。
OFFICIAL_GATEWAY_URL=
OFFICIAL_ACCESS_TOKEN=
OFFICIAL_MODEL=Suinai Flash
OFFICIAL_MODEL_DISPLAY_NAME=Suinai Flash
OFFICIAL_API_KIND=chat-completions
# 用户自配模型在页面“模型设置”中填写，不写进这个模板。
# 8120 运营方配置见 agent/.env.relay.example，不随客户端安装包分发。

# 设备配对、远程任务和会话同步地址；不在这里存官方上游密钥。
AGENT_CLOUD_URL=https://agent.suinai.me

# 对话结束后使用当前模型后台整理；无需向量模型、额外 Key 或模型下载。
AGENT_MEMORY_BACKGROUND=true
