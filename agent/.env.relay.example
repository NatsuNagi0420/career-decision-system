# 青穗集 · 官方服务专用配置，仅部署在 8120 所在服务器。
RELAY_HOST=127.0.0.1
RELAY_PORT=8120
RELAY_TRUST_LOOPBACK_PROXY=false
RELAY_DATA_DIR=
RELAY_ADMIN_TOKEN=
RELAY_UPSTREAM_BASE_URL=
RELAY_UPSTREAM_API_KEY=
RELAY_UPSTREAM_MODEL=
RELAY_API_KIND=chat-completions
RELAY_MODEL_CONVERSATION_SUPPORT=
RELAY_MODEL_PROFILE_DIAGNOSE=
RELAY_MODEL_DIRECTION_EXPLORE=
RELAY_MODEL_COMPARE_DECIDE=
RELAY_MODEL_ACTION_PLAN=
RELAY_MODEL_RESUME_BUILD=
RELAY_MODEL_ARTIFACT_DELIVERY=
RELAY_PATH_COMPARE_DECIDE=
RELAY_DECISION_MODEL=
RELAY_DECISION_PATH=/v1/systemone
RELAY_IMAGE_MODEL=
RELAY_IMAGE_PATH=images/tasks
RELAY_IMAGE_DISPLAY_NAME=Suinai Image
RELAY_UPSTREAM_IDLE_TIMEOUT_MS=120000
RELAY_MAX_OUTPUT_TOKENS=2048
RELAY_DAILY_OUTPUT_TOKEN_LIMIT=64000
RELAY_DAILY_REQUEST_LIMIT=100
RELAY_ALLOW_LOCAL_UPSTREAM=false
RELAY_PUBLIC_MODEL=Suinai Flash
RELAY_DATABASE_URL=
RELAY_TOKEN_TTL_DAYS=30
RELAY_LEASE_TTL_MS=300000
RELAY_BILLING_ENABLED=false
RELAY_INITIAL_CREDIT_MICROS=0
RELAY_INPUT_MICROS_PER_TOKEN=1
RELAY_OUTPUT_MICROS_PER_TOKEN=4
RELAY_IMAGE_MICROS=1000000
RELAY_IMAGE_POLL_INTERVAL_MS=5000
RELAY_IMAGE_TASK_TTL_HOURS=24
RELAY_LOG_RETENTION_DAYS=30
RELAY_ALERT_WEBHOOK_URL=
RELAY_ALERT_WEBHOOK_TOKEN=

# 官方每日积分（产品积分，与上游货币余额分离）
# true 开启后以积分统一控制用量，不再叠加旧的每日次数/输出预算。
RELAY_POINTS_ENABLED=false
RELAY_DAILY_POINTS=2300
RELAY_POINTS_VERSION=2026-10-v1
# 1 积分 = 1,000,000 微积分；以下为每个词元的微积分价格。
RELAY_POINTS_INPUT_MICROS_PER_TOKEN=10000
RELAY_POINTS_CACHED_MICROS_PER_TOKEN=2500
RELAY_POINTS_OUTPUT_MICROS_PER_TOKEN=40000
RELAY_POINTS_IMAGE_MICROS=200000000
