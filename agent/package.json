{
  "name": "qingsuiji-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "relay": "tsx src/relay.ts",
    "relay:token": "tsx src/relay-token.ts",
    "check:tests": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.2.1-rc.2",
    "dotenv": "18.0.8",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
