{
  "name": "qingsuiji-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "relay": "tsx src/relay.ts",
    "relay:token": "tsx src/relay-token.ts",
    "backup": "tsx scripts/backup-agent.ts",
    "check:tests": "tsc --noEmit -p tsconfig.test.json",
    "verify:sandbox:windows": "npm run build && node scripts/verify-windows-sandbox.mjs",
    "relay:migrate": "tsx scripts/migrate-relay.ts",
    "build:local": "tsc -p tsconfig.local.json",
    "build:relay": "tsc -p tsconfig.relay.json",
    "cloud": "tsx src/cloud.ts",
    "build:cloud": "tsc -p tsconfig.cloud.json",
    "start:cloud": "node dist/cloud/cloud.js",
    "hub": "tsx src/hub.ts",
    "build:hub": "tsc -p tsconfig.hub.json",
    "start:hub": "node dist/hub/hub.js",
    "build:desktop": "tsc -p tsconfig.desktop.json",
    "relay:admin": "tsx src/relay-admin.ts",
    "test:account": "tsx scripts/prepare-test-workspace.ts",
    "office:verify": "tsx scripts/verify-officecli.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.2.1-rc.2",
    "dotenv": "18.0.8",
    "fastify": "5.12.7",
    "mammoth": "1.13.0",
    "pg": "^8.23.1",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
