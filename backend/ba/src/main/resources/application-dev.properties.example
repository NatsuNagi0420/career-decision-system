# Development Environment Configuration
# 开发环境配置文件模板
# 使用方式：
# 1. 复制此文件为 application-dev.properties
# 2. 填入你的实际配置信息
# 3. 默认启动或使用 --spring.profiles.active=dev

# Server Configuration
server.port=8080

# Database Configuration - Development
# 开发环境使用本地数据库，请根据实际情况修改
spring.datasource.url=jdbc:mysql://localhost:3306/career_db?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=GMT%2B8
spring.datasource.username=root
spring.datasource.password=your_database_password

# Database Initialization - Development
# 开发环境自动执行数据库初始化脚本
spring.sql.init.mode=always

# Logging - Development
# 开发环境使用 DEBUG 级别便于调试
logging.level.root=INFO
logging.level.com.example.ba=DEBUG
logging.level.com.example.ba.mapper=DEBUG

# AI Configuration - Development
# 请填入你的 AI API 配置信息
# 支持的 API：DeepSeek、通义千问等
ai.api.key=${AI_API_KEY:your_ai_api_key_here}
ai.api.base-url=${AI_API_BASE_URL:https://api.deepseek.com}
ai.api.model=${AI_API_MODEL:deepseek-v4-flash}

# Static Resources Configuration - Development
# 开发环境使用相对路径，资源存储在项目目录下
static.uploads.path=file:./uploads/images/
