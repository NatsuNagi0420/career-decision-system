# 青穗集 · Cloud Hub 运行配置；不填写模型中转的上游 Key。
AGENT_HOST=127.0.0.1
AGENT_PORT=8110
AGENT_DEPLOYMENT_MODE=server
AGENT_PUBLIC_ORIGIN=https://agent.suinai.me
AGENT_ALLOWED_ORIGINS=https://agent.suinai.me
AGENT_DATA_DIR=/var/lib/qingsuiji/agent
AGENT_SERVER_COMMANDS=false
AGENT_MAX_ACTIVE_RUNS=2
OFFICIAL_GATEWAY_URL=https://api.suinai.me/v1
OFFICIAL_MODEL=Suinai Flash
OFFICIAL_MODEL_DISPLAY_NAME=Suinai Flash
OFFICIAL_API_KIND=chat-completions
OFFICIAL_ACCESS_TOKEN=
# false：只做同步与任务转发；true：同时提供独立的云端执行位置。
HUB_CLOUD_EXECUTOR=true
