# 青穗集 · 8120 官方中转生产环境变量模板；复制后填写真实值，禁止提交真实密钥。
RELAY_HOST=127.0.0.1
RELAY_PORT=8120
RELAY_TRUST_LOOPBACK_PROXY=true
RELAY_DATA_DIR=/var/lib/qingsuiji/relay
RELAY_ADMIN_TOKEN=替换为一串仅管理员知道的随机值

# 只填 OpenAI 兼容 API 的基础地址；不要填聊天网页地址，也不要附加 /chat/completions。
RELAY_UPSTREAM_BASE_URL=https://你的上游网关/v1
RELAY_UPSTREAM_API_KEY=替换为上游APIKey
RELAY_UPSTREAM_MODEL=gpt-6.1-terra
RELAY_API_KIND=chat-completions

# 官方能力路由；未填写的能力回退到 RELAY_UPSTREAM_MODEL。
RELAY_MODEL_CONVERSATION_SUPPORT=gpt-6.1-terra
RELAY_MODEL_PROFILE_DIAGNOSE=gpt-6.1-terra
RELAY_MODEL_DIRECTION_EXPLORE=gpt-6.1-terra
RELAY_MODEL_COMPARE_DECIDE=gpt-6.1-terra
RELAY_MODEL_ACTION_PLAN=gpt-6.1-terra
RELAY_MODEL_RESUME_BUILD=gemini-3.8-flash
RELAY_MODEL_ARTIFACT_DELIVERY=gpt-6.1-terra

# Jev 是独立的结构化判断接口；/v1/systemone 是相对上游根域名的完整路径。
RELAY_DECISION_MODEL=Typesafe-jev
RELAY_DECISION_PATH=/v1/systemone

# 暂不启用官方生图时留空；启用前要先确认上游异步图片接口已经可用。
RELAY_IMAGE_MODEL=
RELAY_IMAGE_PATH=images/tasks
RELAY_IMAGE_DISPLAY_NAME=Suinai Image

RELAY_UPSTREAM_IDLE_TIMEOUT_MS=120000
RELAY_MAX_OUTPUT_TOKENS=2048
RELAY_DAILY_OUTPUT_TOKEN_LIMIT=64000
RELAY_DAILY_REQUEST_LIMIT=100
RELAY_ALLOW_LOCAL_UPSTREAM=false
RELAY_PUBLIC_MODEL=Suinai Flash

# 单台 ECS、单个 relay 进程先使用 SQLite；多实例部署时再切换 PostgreSQL。
RELAY_DATABASE_URL=
RELAY_TOKEN_TTL_DAYS=30
RELAY_LEASE_TTL_MS=300000
RELAY_BILLING_ENABLED=false
RELAY_INITIAL_CREDIT_MICROS=0
RELAY_INPUT_MICROS_PER_TOKEN=1
RELAY_OUTPUT_MICROS_PER_TOKEN=4
RELAY_IMAGE_MICROS=1000000
RELAY_IMAGE_POLL_INTERVAL_MS=5000
RELAY_IMAGE_TASK_TTL_HOURS=24
RELAY_LOG_RETENTION_DAYS=30
RELAY_ALERT_WEBHOOK_URL=
RELAY_ALERT_WEBHOOK_TOKEN=
