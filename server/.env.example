APP_ENV=local
LOG_LEVEL=INFO

# Business store. Migrations refuse any target outside career_v2*.
DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/career_v2?charset=utf8mb4
TEST_DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/career_v2_test?charset=utf8mb4

# Resumable execution state, kept apart from business data so it can be discarded.
CHECKPOINT_PATH=./var/checkpoints.sqlite
CHECKPOINTER_PROVIDER=sqlite

# mock = offline, no network. deepseek/qwen/openai-compatible use the key below.
LLM_PROVIDER=mock
LLM_MODEL=mock-career-planner
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.3
LLM_DEFAULT_MAX_TOKENS=2000

INTERNAL_API_TOKEN=change-me-in-local-env-only
APPROVAL_TTL_SECONDS=86400
REPLAY_BUFFER_SIZE=500
EVENT_PAGE_SIZE=200
