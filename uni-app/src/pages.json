    {
      "path": "pages/learning/index",
      "style": { "navigationBarTitleText": "学习路线", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/preparation/index",
      "style": { "navigationBarTitleText": "练习与面试", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/compare/index",
      "style": { "navigationBarTitleText": "岗位比较", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/career-task/index",
